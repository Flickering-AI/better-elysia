{
    "name": "@flickering/better-elysia",
    "version": "1.4.2",
    "license": "MIT",
    "description": "An extended version of Elysia with decorators and more features",
    "author": {
        "name": "ldystudio",
        "email": "dongyangliu@ahaaamath.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Flickering-AI/better-elysia.git"
    },
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./http-status": {
            "types": "./dist/http-status.d.ts",
            "default": "./dist/http-status.js"
        }
    },
    "bin": {
        "better-elysia": "dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "scripts": {
        "dev": "bun --watch index.ts",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "build": "tsc -p tsconfig.build.json",
        "lint": "biome lint --write .",
        "format": "biome format --write .",
        "check": "biome check --write --unsafe .",
        "prepublishOnly": "bun check && bun test && bunx tsc --noEmit && bun run build",
        "release": "npm publish"
    },
    "dependencies": {
        "@elysia/cors": "^1.4.2",
        "@elysia/openapi": "^1.4.15",
        "colors": "^1.4.0",
        "date-fns": "^4.4.0",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@elysia/eden": "1.4.10",
        "@types/bun": "^1.3.14",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "elysia": "^1.4.29"
    }
}
